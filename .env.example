# ==============================================================================
# Vyroh Central Hub - Environment Variables Specification (Production & Dev)
# ==============================================================================

# 1. PostgreSQL Database & Drizzle ORM
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vyroh_hub

# 2. Better-Auth & Session Security
AUTH_SECRET=vyroh_auth_secret_production_random_key_64_chars_min
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. AI Providers (Multi-Provider: Gemini, Anthropic Claude, OpenAI, Ollama Local)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=gemini

# 4. Stripe Connect & Payments Split (Section 28 & 29)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# 5. MCP Server Configuration (Model Context Protocol)
MCP_SERVER_PORT=3001
NODE_ENV=development
